// Lint + format of the web app, and its import rules:
//   - only `src/api/` talks to Tauri: `@tauri-apps/*` and the bridge's raw calls (`invoke`, `listen`,
//     `pickFile`, `notifyChanged`) are imported there only; everything else calls the typed
//     functions in `src/api/<feature>.ts` (events and types from `@/api/bridge` are fine)
//   - only the design kit (`src/components/ui/kit.tsx`) imports the shadcn/ui primitives
//     (`src/components/ui/primitives`)
// Each file matches exactly one override below (Biome does not merge rule options across
// overrides), so every override repeats the full list of patterns that applies to it.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**", "*.ts", "*.json", "*.jsonc", "!src/styles.css", "!components.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // `role="group"` / `role="list"` and aria-labels are deliberate: every interactive
        // element has an accessible name (UI scripts and assistive technology reach it), and a
        // <fieldset> would change the layout. Fields wrap their control, which this rule misses.
        "useSemanticElements": "off",
        "noRedundantRoles": "off",
        "useAriaPropsSupportedByRole": "off",
        "noLabelWithoutControl": "off"
      },
      "suspicious": {
        // Static lists (lines of a brief, notices) have no id; they never reorder.
        "noArrayIndexKey": "off",
        // Mistakes a local `before(...)` helper for a mocha hook.
        "noDuplicateTestHooks": "off",
        // `list.forEach((handler) => handler(x))` is fine.
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "correctness": { "noComponentHookFactories": "off" }
        }
      }
    },
    {
      "includes": ["src/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/primitives", "**/primitives/**", "./primitives", "./primitives/**"],
                    "message": "Use the design kit (@/components/ui/kit); only it builds on the primitives."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/kit.tsx", "src/components/ui/primitives/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/api/bridge": {
                    "importNames": ["invoke", "listen", "pickFile", "notifyChanged"],
                    "message": "Call the shell through a typed function in @/api/<feature>.ts."
                  }
                },
                "patterns": [{ "group": ["@tauri-apps/**"], "message": "Call Tauri through the functions in @/api." }]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/api/**", "!src/components/ui/kit.tsx", "!src/components/ui/primitives/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/api/bridge": {
                    "importNames": ["invoke", "listen", "pickFile", "notifyChanged"],
                    "message": "Call the shell through a typed function in @/api/<feature>.ts."
                  }
                },
                "patterns": [
                  { "group": ["@tauri-apps/**"], "message": "Call Tauri through the functions in @/api." },
                  {
                    "group": ["**/primitives", "**/primitives/**", "./primitives", "./primitives/**"],
                    "message": "Use the design kit (@/components/ui/kit); only it builds on the primitives."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
