{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "0.1.0",
  "description": "Lets the JobPilot desktop app open and drive job pages in tabs of their own.",
  "key": "",
  "minimum_chrome_version": "125",
  "incognito": "spanning",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["debugger", "tabs", "tabGroups", "cookies", "storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "JobPilot",
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/jobpilot-48.png", "128": "icons/jobpilot-256.png" }
  },
  "icons": { "48": "icons/jobpilot-48.png", "128": "icons/jobpilot-256.png" }
}
