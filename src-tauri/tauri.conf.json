{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobPilot",
  "mainBinaryName": "jobpilot",
  "identifier": "dev.phucvinh57.jobpilot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build && bun run ext:build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "object-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "app", "dmg"],
    "icon": [
      "../assets/icons/jobpilot-48.png",
      "../assets/icons/jobpilot-128.png",
      "../assets/icons/jobpilot-256.png",
      "../assets/icons/jobpilot-512.png"
    ],
    "category": "Productivity",
    "resources": { "../extension/dist": "extension" },
    "shortDescription": "Tailored CVs, applications in your own browser, Gmail status tracking",
    "longDescription": "Turns a job description into a CV tailored from your own profile.yaml, lets you edit it, fills the application in a tab of your own Chrome (through the JobPilot extension) and submits it only after you confirm, and tracks replies from Gmail. All data stays on this machine; secrets live in the OS keyring.",
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "../assets/jobpilot.desktop",
        "recommends": ["google-chrome-stable | chromium | chromium-browser", "gnome-keyring | kwalletd6 | kwalletd5"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
